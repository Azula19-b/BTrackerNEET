{
  "name": "btrackerneet",
  "version": "1.0.0",
  "private": true,
  "description": "Offline-first C++ interview practice desktop application",
  "main": "electron/main.cjs",
  "author": "BTrackerNEET",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "validate:data": "node scripts/validate-catalog.mjs",
    "dist": "npm run validate:data && npm run test && npm run build && electron-builder --mac --arm64",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "better-sqlite3": "^12.4.1",
    "monaco-editor": "^0.54.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-is": "^19.3.1",
    "recharts": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^27.0.1",
    "vite": "^7.1.12",
    "vitest": "^4.0.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.btrackerneet.app",
    "productName": "BTrackerNEET",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "data/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "BTrackerNEET ${version}"
    }
  }
}
